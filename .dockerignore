# Keep build context small — don't ship build outputs, IDE state, or local
# secrets into the Docker daemon.
target/
**/target/
.git/
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.log
.DS_Store
Thumbs.db

# Local docker volumes and any compose overrides
docker/postgres/data/
docker-compose.override.yml

# Real .env (contains secrets); .env.example IS shipped intentionally
.env
