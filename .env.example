# Copy to .env and edit as needed. docker compose auto-loads .env from the
# project root. Every variable here is optional — defaults are sane for
# `docker compose up -d` on a clean machine.

# ===== Host ports =====
# Override only if you have local services already on these ports.
ORDER_PORT=8081
PAYMENT_PORT=8082
INVENTORY_PORT=8083
UI_PORT=8080
POSTGRES_PORT=5432
KAFKA_PORT=9092
KAFDROP_PORT=9000
REDIS_PORT=6379

# ===== Postgres =====
POSTGRES_USER=saga
POSTGRES_PASSWORD=saga
POSTGRES_DB=saga

# ===== Inventory stock engine =====
# REDIS    — atomic Lua decrement (default, recommended for flash sale)
# DATABASE — pessimistic-lock SELECT FOR UPDATE on Postgres
# AUTO     — SaleWindowSwitcher flips REDIS <-> DATABASE based on SALE_WINDOWS
STOCK_SOURCE=REDIS

# Comma-separated HH:MM-HH:MM windows (server local time).
# Only consulted when STOCK_SOURCE=AUTO.
SALE_WINDOWS=

# ===== Payment behaviour (demo knob) =====
# Total order amount above which payment-service rejects the charge. Use a low
# number to make the compensating path easy to trigger from the UI.
PAYMENT_FAIL_ABOVE=5000

# ===== Saga timeouts =====
# Non-terminal sagas older than this are forced to a safe terminal state
# (see SagaTimeoutScanner).
SAGA_TIMEOUT_SECONDS=120
SAGA_OUTBOX_POLL_MS=500

# ===== JVM (per service heap) =====
# Defaults tuned for the 2 cpu / 2 GB total budget (homelab). Bump if your
# host has more RAM. The container mem_limit in docker-compose.yml is
# separate and gives ~64-96 MB headroom above each heap for metaspace, GC
# and native memory.
ORDER_JAVA_OPTS=-Xmx144m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -XX:MaxGCPauseMillis=100
PAYMENT_JAVA_OPTS=-Xmx112m -XX:MaxMetaspaceSize=112m -XX:+UseG1GC -XX:MaxGCPauseMillis=100
INVENTORY_JAVA_OPTS=-Xmx144m -XX:MaxMetaspaceSize=128m -XX:+UseG1GC -XX:MaxGCPauseMillis=100
UI_JAVA_OPTS=-Xmx128m -XX:MaxMetaspaceSize=112m -XX:+UseG1GC -XX:MaxGCPauseMillis=100
